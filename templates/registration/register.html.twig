{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center">User Registration</h1>
    <div class="row justify-content-center">
        <div class="col-md-6">
            {{ form_start(registrationForm, {'attr': {'class': 'needs-validation'}}) }}
                <div class="form-group mb-3">
                    {{ form_label(registrationForm.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>
                <div class="form-group mb-3">
                    {{ form_label(registrationForm.password.first, 'Password', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.password.first, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.password.first) }}
                </div>
                <div class="form-group mb-3">
                    {{ form_label(registrationForm.password.second, 'Confirm Password', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.password.second, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(registrationForm.password.second) }}
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Register</button>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}